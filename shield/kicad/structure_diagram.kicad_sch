	(text "SMARTCARD INTERFACE (ST8034)"
		(exclude_from_sim no)
		(at 25 25 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left)
		)
		(uuid "8cef0d58-8023-4a38-8bad-146248f0d7ad")
	)
	(text "ST ST8034 smartcard interface IC (U6, QFN-24).\nISO 7816 compliant: handles clock, reset, I/O, and power.\nSmartcard socket J8 (7312P0225A13LF) with card detect.\nSC_IO: bidirectional data line to MCU (UART TX/RX via U6).\nSC_CLK: clock output to card. SC_RST: reset output to card.\nSC_VCC: regulated card supply from U6. SC_PRESN: card presence detect.\nCommunication with secure element is encrypted end-to-end;\nthe smartcard controller learns nothing about transmitted data."
		(exclude_from_sim no)
		(at 25 31 0)
		(effects
			(font
				(size 1.5 1.5)
				(color 0 0 150 1)
			)
			(justify left)
		)
		(uuid "bdcdcfda-2a69-4d6e-a837-72bf6aa72085")
	)
	(text "QR SCANNER (FFC)"
		(exclude_from_sim no)
		(at 25 130 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left)
		)
		(uuid "92c231ec-6476-4867-bea9-88e33e6c3d87")
	)
	(text "GROW GM65-S QR/barcode scanner module connection.\nFFC connector J10 (SFV12R-2STE1HLF, 12-pin 0.5mm pitch).\nSimple UART interface: QR_TX (data from scanner to MCU),\nQR_RX (commands from MCU to scanner).\nQR_TRIG: hardware trigger for scan initiation.\nScanner only captures images and sends scanned data;\nno security-critical processing in the scanner module."
		(exclude_from_sim no)
		(at 25 136 0)
		(effects
			(font
				(size 1.5 1.5)
				(color 0 0 150 1)
			)
			(justify left)
		)
		(uuid "69f07bd2-2d75-4cc6-af52-4acee5c38544")
	)
	(text "ARDUINO SHIELD HEADERS"
		(exclude_from_sim no)
		(at 280 25 0)
		(effects
			(font
				(size 3 3)
			)
			(justify left)
		)
		(uuid "2087f790-73f7-48cb-b5fe-71045d7607af")
	)
	(text "Standard Arduino Uno R3 header pinout for\nSTM32F469I-Discovery board compatibility.\nJ9:  D8-D13 (digital), GND, AREF, SDA, SCL.\nJ11: D0-D7 (digital), incl. D0/RX and D1/TX for UART.\nJ12: A0-A3 (analog inputs), I2C SDA/SCL.\nJ13: Power header (V3V3, GND, VIN).\nI2C bus shared between fuel gauge (STC3100),\nsmartcard interface, and MCU."
		(exclude_from_sim no)
		(at 280 31 0)
		(effects
			(font
				(size 1.5 1.5)
				(color 0 0 150 1)
			)
			(justify left)
		)
		(uuid "56190cc7-5215-4da5-bab5-0c46ebebacda")
	)
	(text "BUZZER"
		(exclude_from_sim no)
		(at 25 215 0)
		(effects
