				(size 3 3)
			)
			(justify left)
		)
		(uuid "6a7b15a8-16fc-41e8-ab09-948588489094")
	)
	(text "Piezo buzzer LS1 (SMT-1127-S-R / TDK PS1240P02BT).\nDriven by BUZZER signal from MCU GPIO.\nUsed for audible feedback (key press confirmation,\ntransaction signing alerts, error notifications)."
		(exclude_from_sim no)
		(at 25 221 0)
		(effects
			(font
				(size 1.5 1.5)
				(color 0 0 150 1)
			)
			(justify left)
		)
		(uuid "438117f4-33e6-4b49-bbf7-8004e053bba6")
	)
